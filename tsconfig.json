{
  "compilerOptions": {
    "target": "ESNext", // latest JS features
    "lib": ["dom", "dom.iterable", "esnext"], // DOM + modern ES
    "allowJs": true,
    "skipLibCheck": true, // avoid type issues from deps
    "strict": true, // good for Next.js 15
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext", // match Next.js bundler
    "moduleResolution": "Bundler", // ✅ Next.js 15 requirement
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
